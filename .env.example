# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# ---- Frontend (baked into the build by Vite; also set these on the host) ----
# Supabase dashboard > Project Settings > API (or "Connect" > App Frameworks)
# Production ref is actgfkpgwcfwxaecplhi. Any other ref shows the STAGING banner.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon (legacy JWT) or publishable (sb_publishable_...) key. NEVER the service_role/secret key.
VITE_SUPABASE_ANON_KEY=

# ---- Scripts only (npm run backup:prod / clone:staging / migrate) ----
# Supabase dashboard > Connect > Session pooler (port 5432) connection string, with your DB password filled in.
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
PROD_DB_URL=postgresql://postgres.actgfkpgwcfwxaecplhi:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
STAGING_DB_URL=postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The production project's NAME as shown in the Supabase dashboard. `npm run migrate -- prod`
# makes you type it to confirm.
PROD_PROJECT_NAME=

# Optional: full path to the PostgreSQL bin folder if pg_dump/psql are not on PATH.
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
